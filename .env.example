# App
NODE_ENV=development
PORT=3000

# Public base URL
PUBLIC_BASE_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:4200

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=theindex
DB_PASS=theindex
DB_NAME=theindex
DB_SYNC=true

# JWT
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Seed accounts
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_PASSWORD=admin

# Media (src/media/media-kind.ts). Two storage areas:
# - Public (article images): the API writes processed images to MEDIA_STORAGE_DIR and returns
#   URLs under MEDIA_PUBLIC_URL, which serves that folder. In development they default to
#   ./media-storage, served by the API at http://localhost:3000/media-files. Production:
#   MEDIA_STORAGE_DIR=/data/media (a Docker volume) and MEDIA_PUBLIC_URL=https://media.theindex.training.
# - Private (workouts' lesson-plan PDFs): MEDIA_PRIVATE_STORAGE_DIR, a folder nothing serves; only
#   the API reads it, behind a guard. It must be outside MEDIA_STORAGE_DIR. Development default
#   ./media-storage-private. Production: e.g. /data/media-private, its own Docker volume, NOT
#   mounted into nginx.
# All three are required in production; without them the matching media requests answer 503 (a
# PDF import still fills the form, without keeping the PDF). The API itself always starts.
MEDIA_STORAGE_DIR=media-storage
MEDIA_PUBLIC_URL=http://localhost:3000/media-files
MEDIA_PRIVATE_STORAGE_DIR=media-storage-private
# Largest accepted upload, in megabytes (default 15).
MEDIA_MAX_UPLOAD_MB=15

# Integration tests (npm run test:int). Read from the environment, not from
# .env. The schema is dropped on every run, so the name must end in _test.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_USER=theindex
TEST_DB_PASS=theindex
TEST_DB_NAME=theindex_test
