# App
NODE_ENV=development
PORT=3000

# Public base URL
PUBLIC_BASE_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:4200

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=theindex
DB_PASS=theindex
DB_NAME=theindex
DB_SYNC=true

# JWT
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Seed accounts
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_PASSWORD=admin

# Media (article images). The API writes processed images to MEDIA_STORAGE_DIR and returns
# URLs under MEDIA_PUBLIC_URL. Both are required in production (media requests answer 503
# without them; the API still starts). In development they default to ./media-storage, served
# by the API at http://localhost:3000/media-files. Production: MEDIA_STORAGE_DIR=/data/media
# (a Docker volume) and MEDIA_PUBLIC_URL=https://media.theindex.training.
MEDIA_STORAGE_DIR=media-storage
MEDIA_PUBLIC_URL=http://localhost:3000/media-files
# Largest accepted upload, in megabytes (default 15).
MEDIA_MAX_UPLOAD_MB=15

# Integration tests (npm run test:int). Read from the environment, not from
# .env. The schema is dropped on every run, so the name must end in _test.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_USER=theindex
TEST_DB_PASS=theindex
TEST_DB_NAME=theindex_test
