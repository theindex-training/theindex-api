# App
NODE_ENV=development
PORT=3000

# Public base URL
PUBLIC_BASE_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:4200

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=theindex
DB_PASS=theindex
DB_NAME=theindex
DB_SYNC=true

# JWT
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Seed accounts
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_PASSWORD=admin

# Integration tests (npm run test:int). Read from the environment, not from
# .env. The schema is dropped on every run, so the name must end in _test.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_USER=theindex
TEST_DB_PASS=theindex
TEST_DB_NAME=theindex_test
